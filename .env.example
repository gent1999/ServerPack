# PostgreSQL connection (Neon pooled connection recommended for app runtime)
DATABASE_URL=

# Direct/unpooled connection, used by Prisma Migrate (Neon's pooled
# connection does not reliably support the advisory locks migrations need)
DIRECT_URL=

JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORT=5000
FRONTEND_URL=http://localhost:5173
