generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Artist {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  featured      Boolean  @default(false)
  bio           String?  @db.Text
  imageUrl      String?
  spotifyUrl    String?
  soundcloudUrl String?
  youtubeUrl    String?
  geniusUrl     String?
  appleMusicUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("artists")
}

model RadioTrack {
  id             Int      @id @default(autoincrement())
  title          String
  artist         String
  spotifyTrackId String?
  featured       Boolean  @default(false)
  blurb          String?  @db.Text
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("radio_tracks")
}

model Article {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  tag           String   @default("General")
  content       String   @db.Text
  authorName    String   @default("Wolfpack.fm")
  imageUrl      String?
  spotifyUrl    String?
  soundcloudUrl String?
  youtubeUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publishedAt   DateTime @default(now())

  @@map("articles")
}
